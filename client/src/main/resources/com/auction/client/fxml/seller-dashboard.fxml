<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<AnchorPane fx:id="sellerDashboardPane" prefWidth="1400.0" prefHeight="800.0"
            styleClass="auction-bg"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.client.controller.SellerDashboardController">

    <children>

        <!-- ═══════════════════════════════════════════════════
             HEADER – đồng bộ với auction-list / bidding
             ═══════════════════════════════════════════════════ -->
        <HBox alignment="CENTER_LEFT" spacing="14.0"
              AnchorPane.topAnchor="24.0"
              AnchorPane.leftAnchor="30.0"
              AnchorPane.rightAnchor="30.0"
              prefHeight="88.0"
              styleClass="glass-box"
              style="-fx-background-radius: 20; -fx-padding: 16 36 16 36;">

            <ImageView fitHeight="52.0" fitWidth="52.0"
                       pickOnBounds="true"
                       preserveRatio="true"
                       style="-fx-effect: dropshadow(gaussian, #9b59b640, 8, 0, 0, 2);">
                <image>
                    <Image url="@/com/auction/client/images/bg_login.jpg"/>
                </image>
            </ImageView>

            <VBox alignment="CENTER_LEFT" spacing="2.0">
                <Label text="Online Auction System" styleClass="auction-title"/>
                <Label text="Sàn đấu giá trực tuyến – Sôi động · Uy tín · Minh bạch"
                       styleClass="auction-subtitle"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox alignment="CENTER" spacing="14.0">
                <ImageView fx:id="imgAvatar"
                           fitHeight="40.0" fitWidth="40.0"
                           preserveRatio="true"
                           style="-fx-effect: dropshadow(gaussian, #9b59b660, 6, 0, 0, 1);">
                    <image>
                        <Image url="@/com/auction/client/images/default_avatar.png"/>
                    </image>
                </ImageView>
                <VBox alignment="CENTER_LEFT" spacing="1.0">
                    <Label fx:id="lblUser"
                           style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #431476;"/>
                    <Label text="Người bán"
                           style="-fx-font-size: 12px; -fx-text-fill: #9b59b6;"/>
                </VBox>
                <Button fx:id="btnLogout" text="Đăng xuất"
                        onAction="#handleLogout"
                        styleClass="btn-auction-primary"
                        style="-fx-font-size: 12.5px; -fx-padding: 7 22;"/>
                <Button text="💵 Ví doanh thu" onAction="#handleOpenWallet"
                        style="-fx-background-color: #27ae60; -fx-text-fill: white;
                               -fx-font-size: 12.5px; -fx-padding: 7 18;
                               -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: bold;"/>
            </HBox>
        </HBox>

        <!-- ═══════════════════════════════════════════════════
             THỐNG KÊ NHANH – 4 thẻ nhỏ
             ═══════════════════════════════════════════════════ -->
        <HBox spacing="16.0"
              AnchorPane.topAnchor="128.0"
              AnchorPane.leftAnchor="30.0"
              AnchorPane.rightAnchor="30.0"
              prefHeight="98.0">

            <!-- Tổng sản phẩm -->
            <VBox alignment="CENTER" spacing="4.0" HBox.hgrow="ALWAYS"
                  styleClass="glass-box"
                  style="-fx-background-radius: 16; -fx-padding: 16 24;">
                <Label text="Tổng sản phẩm" styleClass="field-label"/>
                <Label fx:id="lblTotalItems" text="0"
                       style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #431476;"/>
            </VBox>

            <!-- Đang đấu giá -->
            <VBox alignment="CENTER" spacing="4.0" HBox.hgrow="ALWAYS"
                  styleClass="glass-box"
                  style="-fx-background-radius: 16; -fx-padding: 16 24;">
                <Label text="Đang đấu giá" styleClass="field-label"/>
                <Label fx:id="lblActiveItems" text="0"
                       style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
            </VBox>

            <!-- Đã kết thúc -->
            <VBox alignment="CENTER" spacing="4.0" HBox.hgrow="ALWAYS"
                  styleClass="glass-box"
                  style="-fx-background-radius: 16; -fx-padding: 16 24;">
                <Label text="Đã kết thúc" styleClass="field-label"/>
                <Label fx:id="lblClosedItems" text="0"
                       style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #7f8c8d;"/>
            </VBox>

            <!-- Tổng doanh thu -->
            <VBox alignment="CENTER" spacing="4.0" HBox.hgrow="ALWAYS"
                  styleClass="glass-box"
                  style="-fx-background-radius: 16; -fx-padding: 16 24;">
                <Label text="Doanh thu ước tính" styleClass="field-label"/>
                <Label fx:id="lblTotalRevenue" text="0 VNĐ"
                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #c0392b;"/>
            </VBox>
        </HBox>

        <!-- ═══════════════════════════════════════════════════
             NỘI DUNG CHÍNH – chia 2 cột
             Trái: form đăng sản phẩm
             Phải: danh sách sản phẩm của seller
             ═══════════════════════════════════════════════════ -->
        <HBox spacing="20.0"
              AnchorPane.topAnchor="242.0"
              AnchorPane.leftAnchor="30.0"
              AnchorPane.rightAnchor="30.0"
              AnchorPane.bottomAnchor="36.0">

            <!-- ══════════════════════════════
                 CỘT TRÁI – Form đăng sản phẩm
                 ══════════════════════════════ -->
            <VBox spacing="18.0" prefWidth="400.0"
                  styleClass="glass-box"
                  style="-fx-background-radius: 20; -fx-padding: 30 34 26 34;">

                <Label text="Đăng sản phẩm mới"
                       styleClass="login-main-title"/>

                <Separator style="-fx-background-color: #9b59b630;"/>

                <!-- Tên sản phẩm -->
                <VBox alignment="CENTER_LEFT" spacing="6.0">
                    <Label text="Tên sản phẩm" styleClass="field-label"/>
                    <TextField fx:id="txtProductName"
                               promptText="Nhập tên sản phẩm"
                               styleClass="input-auction"/>
                </VBox>

                <!-- Mô tả -->
                <VBox alignment="CENTER_LEFT" spacing="6.0">
                    <Label text="Mô tả chi tiết" styleClass="field-label"/>
                    <TextArea fx:id="txtDescription"
                              promptText="Mô tả tình trạng, xuất xứ, đặc điểm sản phẩm..."
                              styleClass="input-auction"
                              prefHeight="110.0"
                              wrapText="true"
                              style="-fx-font-size: 14px;"/>
                </VBox>

                <!-- Giá khởi điểm -->
                <VBox alignment="CENTER_LEFT" spacing="6.0">
                    <Label text="Giá khởi điểm (VNĐ)" styleClass="field-label"/>
                    <TextField fx:id="txtStartPrice"
                               promptText="Ví dụ: 500000"
                               styleClass="input-auction"/>
                </VBox>

                <!-- Bước giá -->
                <VBox alignment="CENTER_LEFT" spacing="6.0">
                    <Label text="Bước giá tối thiểu (VNĐ)" styleClass="field-label"/>
                    <TextField fx:id="txtMinIncrement"
                               promptText="Ví dụ: 50000"
                               styleClass="input-auction"/>
                </VBox>

                <!-- Thời gian -->
                <VBox alignment="CENTER_LEFT" spacing="6.0">
                    <Label text="Thời gian đấu giá (phút)" styleClass="field-label"/>
                    <TextField fx:id="txtDuration"
                               promptText="Ví dụ: 60"
                               styleClass="input-auction"/>
                </VBox>

                <!-- Nút đăng -->
                <Button fx:id="btnAddItem"
                        text="ĐĂNG PHIÊN ĐẤU GIÁ"
                        onAction="#handleAddItem"
                        styleClass="btn-auction-primary"
                        maxWidth="Infinity"
                        style="-fx-font-size: 14.5px; -fx-padding: 12 0; -fx-font-weight: bold;"/>

                <!-- Thông báo -->
                <Label fx:id="lblFormMessage"
                       visible="false"
                       wrapText="true"
                       alignment="CENTER"
                       style="-fx-font-size: 13px; -fx-text-fill: #e74c3c; -fx-padding: 4 0 0 0;"/>
            </VBox>

            <!-- ══════════════════════════════
                 CỘT PHẢI – Danh sách sản phẩm
                 ══════════════════════════════ -->
            <VBox spacing="16.0" HBox.hgrow="ALWAYS"
                  styleClass="glass-box"
                  style="-fx-background-radius: 20; -fx-padding: 30 34 26 34;">

                <!-- Tiêu đề + tìm kiếm -->
                <HBox alignment="CENTER_LEFT" spacing="14.0">
                    <VBox spacing="2.0">
                        <Label text="Sản phẩm của bạn"
                               styleClass="login-main-title"/>
                        <Label fx:id="lblItemCount" text=""
                               style="-fx-font-size: 13px; -fx-text-fill: #9b59b6;"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <VBox alignment="CENTER_LEFT" spacing="4.0">
                        <Label text="Lọc trạng thái" styleClass="field-label"/>
                        <ComboBox fx:id="cboStatusFilter"
                                  promptText="Tất cả"
                                  prefWidth="160.0"
                                  styleClass="input-auction"
                                  onAction="#handleStatusFilter"/>
                    </VBox>
                    <VBox alignment="CENTER_LEFT" spacing="4.0">
                        <Label text=" " styleClass="field-label"/>
                        <Button fx:id="btnRefresh" text="⟳  Làm mới"
                                onAction="#handleRefresh"
                                styleClass="btn-auction-primary"
                                style="-fx-font-size: 13px; -fx-padding: 8 20;"/>
                    </VBox>
                </HBox>

                <Separator style="-fx-background-color: #9b59b630;"/>

                <!-- Bảng sản phẩm -->
                <TableView fx:id="tvSellerItems"
                           VBox.vgrow="ALWAYS"
                           style="-fx-background-radius: 14; -fx-font-size: 14px;
                                  -fx-background-color: transparent;">
                    <columns>
                        <TableColumn fx:id="colNo"       text="#"             prefWidth="46.0"  style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colName"     text="Tên Sản Phẩm"  prefWidth="220.0"/>
                        <TableColumn fx:id="colStart"    text="Giá Khởi Điểm" prefWidth="140.0" style="-fx-alignment: CENTER_RIGHT;"/>
                        <TableColumn fx:id="colPrice"    text="Giá Hiện Tại"  prefWidth="140.0" style="-fx-alignment: CENTER_RIGHT;"/>
                        <TableColumn fx:id="colBidCount" text="Lượt Đặt"      prefWidth="90.0"  style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colStatus"   text="Trạng Thái"    prefWidth="115.0" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colEndTime"  text="Kết Thúc"      prefWidth="140.0" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colAction"   text="Thao Tác"      prefWidth="120.0" style="-fx-alignment: CENTER;"/>
                    </columns>
                    <placeholder>
                        <VBox alignment="CENTER" spacing="10.0">
                            <Label text="Bạn chưa đăng sản phẩm nào"
                                   style="-fx-font-size: 15px; -fx-text-fill: #9b59b6;
                                          -fx-font-style: italic;"/>
                            <Label text="Hãy điền form bên trái để đăng phiên đấu giá đầu tiên!"
                                   style="-fx-font-size: 13px; -fx-text-fill: #bdc3c7;"/>
                        </VBox>
                    </placeholder>
                </TableView>

                <!-- Thông báo bảng -->
                <Label fx:id="lblTableMessage"
                       visible="false"
                       wrapText="true"
                       alignment="CENTER"
                       style="-fx-font-size: 13.5px; -fx-text-fill: #e67e22; -fx-padding: 4 0 0 0;"/>
            </VBox>
        </HBox>

        <!-- ═══════════════════════════════════════════════════
             FOOTER
             ═══════════════════════════════════════════════════ -->
        <HBox alignment="CENTER"
              AnchorPane.bottomAnchor="8.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0">
            <Label text="© 2026 Auction House – Nơi kết nối người bán và người mua uy tín | Hotline: 1900-8888"
                   style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d88;"/>
        </HBox>

    </children>
</AnchorPane>
