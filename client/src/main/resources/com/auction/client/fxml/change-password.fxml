<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<!--
    change-password.fxml
    ────────────────────
    A compact modal window opened from the profile popup dropdown.
    Opened via: ViewLoader.openInNewWindow("change-password.fxml", "Đổi mật khẩu")

    Preferred Stage dimensions: 420 × 560  (set on the Stage in ViewLoader)
    Styling: inline styles that reproduce the "Dark-purple Glassmorphism" design
             system used across the rest of the application, so this window looks
             like a natural extension of the profile popup card.

    Layout hierarchy:
      StackPane  (deep-purple bg, fills window)
       └─ VBox   (glassmorphism card, centred)
            ├─ VBox   header  – lock icon + title + subtitle
            ├─ VBox   inputs  – 3 labelled PasswordFields
            ├─ Label  lblError – inline validation / error feedback
            └─ HBox   actions – Cancel | Confirm buttons
-->
<StackPane xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.auction.client.controller.ChangePasswordController"
           prefWidth="420.0" prefHeight="560.0"
           style="-fx-background-color: #1a0a2e;">

    <children>

        <!-- ══════════════════════════════════════
             GLASS CARD
             ══════════════════════════════════════ -->
        <VBox alignment="TOP_CENTER" spacing="0.0"
              maxWidth="360.0"
              style="-fx-background-color: rgba(35,10,60,0.93);
                     -fx-background-radius: 22;
                     -fx-border-color: rgba(155,89,182,0.42);
                     -fx-border-width: 1.5;
                     -fx-border-radius: 22;
                     -fx-effect: dropshadow(gaussian, rgba(67,20,118,0.65), 36, 0, 0, 10);">

            <!-- ── HEADER ── -->
            <VBox alignment="CENTER" spacing="10.0"
                  style="-fx-padding: 32 28 22 28;">

                <!-- Lock icon badge -->
                <StackPane prefWidth="68.0" prefHeight="68.0"
                           style="-fx-background-color: rgba(142,68,173,0.22);
                                  -fx-background-radius: 50;
                                  -fx-border-color: rgba(155,89,182,0.50);
                                  -fx-border-width: 1.5;
                                  -fx-border-radius: 50;">
                    <Label text="🔐"
                           style="-fx-font-size: 28px; -fx-text-fill: #e8c9ff;"/>
                </StackPane>

                <Label text="Đổi Mật Khẩu"
                       style="-fx-font-size: 20px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #f0e6ff;"/>

                <Label text="Nhập mật khẩu hiện tại và mật khẩu mới của bạn"
                       wrapText="true" alignment="CENTER"
                       style="-fx-font-size: 12.5px;
                              -fx-text-fill: #dcd0ff;
                              -fx-text-alignment: center;"/>
            </VBox>

            <!-- ── THIN PURPLE DIVIDER ── -->
            <Separator style="-fx-background-color: rgba(155,89,182,0.28);
                               -fx-padding: 0 20;"/>

            <!-- ── INPUT FIELDS ── -->
            <VBox spacing="16.0"
                  style="-fx-padding: 24 28 6 28;">

                <!-- Current password -->
                <VBox spacing="6.0">
                    <Label text="Mật khẩu hiện tại"
                           style="-fx-font-size: 12px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #e8c9ff;"/>
                    <PasswordField fx:id="txtOldPassword"
                                   promptText="Nhập mật khẩu hiện tại"
                                   style="-fx-background-color: rgba(255,255,255,0.07);
                                          -fx-background-radius: 10;
                                          -fx-border-color: rgba(155,89,182,0.45);
                                          -fx-border-width: 1.5;
                                          -fx-border-radius: 10;
                                          -fx-text-fill: #f0e6ff;
                                          -fx-prompt-text-fill: rgba(155,89,182,0.55);
                                          -fx-font-size: 14px;
                                          -fx-padding: 10 14;"/>
                </VBox>

                <!-- New password -->
                <VBox spacing="6.0">
                    <Label text="Mật khẩu mới"
                           style="-fx-font-size: 12px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #e8c9ff;"/>
                    <PasswordField fx:id="txtNewPassword"
                                   promptText="Tối thiểu 6 ký tự"
                                   style="-fx-background-color: rgba(255,255,255,0.07);
                                          -fx-background-radius: 10;
                                          -fx-border-color: rgba(155,89,182,0.45);
                                          -fx-border-width: 1.5;
                                          -fx-border-radius: 10;
                                          -fx-text-fill: #f0e6ff;
                                          -fx-prompt-text-fill: rgba(155,89,182,0.55);
                                          -fx-font-size: 14px;
                                          -fx-padding: 10 14;"/>
                </VBox>

                <!-- Confirm new password -->
                <VBox spacing="6.0">
                    <Label text="Xác nhận mật khẩu mới"
                           style="-fx-font-size: 12px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #e8c9ff;"/>
                    <PasswordField fx:id="txtConfirmPassword"
                                   promptText="Nhập lại mật khẩu mới"
                                   style="-fx-background-color: rgba(255,255,255,0.07);
                                          -fx-background-radius: 10;
                                          -fx-border-color: rgba(155,89,182,0.45);
                                          -fx-border-width: 1.5;
                                          -fx-border-radius: 10;
                                          -fx-text-fill: #f0e6ff;
                                          -fx-prompt-text-fill: rgba(155,89,182,0.55);
                                          -fx-font-size: 14px;
                                          -fx-padding: 10 14;"/>
                </VBox>
            </VBox>

            <!-- ── INLINE ERROR / SUCCESS LABEL ── -->
            <!-- Visible only when the controller calls showFeedback(). -->
            <Label fx:id="lblFeedback"
                   wrapText="true"
                   alignment="CENTER"
                   visible="false"
                   managed="false"
                   style="-fx-font-size: 12.5px;
                          -fx-padding: 10 28 0 28;
                          -fx-text-alignment: center;"/>

            <!-- ── ACTION BUTTONS ── -->
            <HBox spacing="12.0" alignment="CENTER"
                  style="-fx-padding: 22 28 28 28;">

                <!-- Cancel -->
                <Button fx:id="btnCancel"
                        text="Huỷ"
                        onAction="#handleCancel"
                        prefWidth="130.0"
                        style="-fx-background-color: rgba(255,255,255,0.08);
                               -fx-text-fill: #e8c9ff;
                               -fx-font-size: 13.5px;
                               -fx-font-weight: bold;
                               -fx-background-radius: 10;
                               -fx-border-color: rgba(155,89,182,0.40);
                               -fx-border-width: 1.5;
                               -fx-border-radius: 10;
                               -fx-cursor: hand;
                               -fx-padding: 10 20;"/>

                <!-- Confirm -->
                <Button fx:id="btnConfirm"
                        text="🔐  Xác nhận"
                        onAction="#handleConfirm"
                        prefWidth="160.0"
                        style="-fx-background-color: linear-gradient(to right, #6c3483, #8e44ad);
                               -fx-text-fill: white;
                               -fx-font-size: 13.5px;
                               -fx-font-weight: bold;
                               -fx-background-radius: 10;
                               -fx-border-radius: 10;
                               -fx-cursor: hand;
                               -fx-padding: 10 20;
                               -fx-effect: dropshadow(gaussian, rgba(142,68,173,0.55), 10, 0, 0, 3);"/>
            </HBox>

        </VBox>
        <!-- ══ end glass card ══ -->

    </children>
</StackPane>
