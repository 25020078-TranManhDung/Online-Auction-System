<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.chart.*?>
<?import javafx.geometry.Insets?>

<AnchorPane fx:id="auctionDetailPane" prefWidth="1400.0" prefHeight="800.0"
            minWidth="800.0" minHeight="600.0"
            styleClass="auction-bg"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.client.controller.AuctionDetailController">

    <children>

        <!-- ═══════════════════════════════════════════════════
             HEADER – đồng bộ với tất cả file trước
             ═══════════════════════════════════════════════════ -->
        <HBox alignment="CENTER_LEFT" spacing="14.0"
              AnchorPane.topAnchor="24.0"
              AnchorPane.leftAnchor="30.0"
              AnchorPane.rightAnchor="30.0"
              prefHeight="88.0"
              styleClass="glass-box"
              style="-fx-background-radius: 20; -fx-padding: 16 36 16 36;">

            <ImageView fitHeight="52.0" fitWidth="52.0"
                       pickOnBounds="true"
                       style="-fx-effect: dropshadow(gaussian, #9b59b640, 8, 0, 0, 2);">
                <image>
                    <Image url="@../images/logo.png"/>
                </image>
            </ImageView>

            <VBox alignment="CENTER_LEFT" spacing="2.0">
                <Label text="AUCTION HOUSE" styleClass="auction-title"/>
                <Label text="Sàn đấu giá trực tuyến – Sôi động · Uy tín · Minh bạch"
                       styleClass="auction-subtitle"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox alignment="CENTER" spacing="16.0">

                <VBox alignment="CENTER_RIGHT" spacing="3.0">
                    <HBox alignment="CENTER_RIGHT" spacing="6.0">
                        <Label text="Số dư:" style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;"/>
                        <Label fx:id="lblWalletBalance" text="Đang tải..."
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                    </HBox>
                    <Button text="💳 Chi tiết ví" onAction="#handleOpenWallet"
                            style="-fx-background-color: #8e44ad; -fx-text-fill: white;
                                   -fx-font-size: 11.5px; -fx-padding: 4 12;
                                   -fx-background-radius: 8; -fx-cursor: hand;"/>
                </VBox>

                <HBox fx:id="headerUserArea" alignment="CENTER_LEFT" spacing="12.0" style="-fx-cursor: hand; -fx-padding: 4 6;">
                    <ImageView fx:id="imgAvatar"
                               fitHeight="40.0" fitWidth="40.0"
                               style="-fx-effect: dropshadow(gaussian, #9b59b660, 6, 0, 0, 1);">
                        <image>
                            <Image url="@../images/default_avatar.png"/>
                        </image>
                    </ImageView>

                    <VBox alignment="CENTER_LEFT" spacing="3.0">
                        <Label fx:id="lblUser"
                               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #431476;"/>

                        <HBox alignment="CENTER" style="-fx-background-color: #9b59b6; -fx-background-radius: 6; -fx-padding: 2 10;">
                            <Label fx:id="lblRole"
                                   style="-fx-font-size: 11px; -fx-text-fill: white; -fx-font-weight: bold;"/>
                        </HBox>
                    </VBox>

                    <Label text="▼" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d; -fx-padding: 0 0 0 2;"/>
                </HBox>

                <Button fx:id="btnTheme"
                        onAction="#handleToggleTheme"
                        styleClass="btn-auction-primary"
                        style="-fx-font-size: 12px; -fx-padding: 7 16;
                               -fx-background-color: rgba(80,30,120,0.7);"/>
                <Button fx:id="btnBack" text="← Danh sách"
                        onAction="#handleBack"
                        styleClass="btn-auction-primary"
                        style="-fx-font-size: 12.5px; -fx-padding: 7 22;"/>
            </HBox>
        </HBox>

        <!-- ═══════════════════════════════════════════════════
             NỘI DUNG CHÍNH – chia 3 cột
             Trái : ảnh + thông tin sản phẩm + nút đặt giá
             Giữa : biểu đồ giá theo thời gian
             Phải : lịch sử đặt giá (ListView)
             ═══════════════════════════════════════════════════ -->
        <HBox spacing="18.0"
              AnchorPane.topAnchor="128.0"
              AnchorPane.leftAnchor="30.0"
              AnchorPane.rightAnchor="30.0"
              AnchorPane.bottomAnchor="36.0">

            <!-- ══════════════════════════════════════
                 CỘT TRÁI – Thông tin sản phẩm & đặt giá
                 ══════════════════════════════════════ -->
            <VBox spacing="16.0" prefWidth="420.0" HBox.hgrow="SOMETIMES">

                <ScrollPane VBox.vgrow="ALWAYS" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                            style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 0;">

                    <VBox spacing="16.0">
                        <VBox spacing="14.0"
                              styleClass="glass-box"
                              style="-fx-background-radius: 20; -fx-padding: 28 32 24 32;">

                            <Label fx:id="lblProductName" text="—"
                                   wrapText="true"
                                   styleClass="login-main-title"/>

                            <Separator style="-fx-background-color: #9b59b630;"/>

                            <HBox spacing="36.0">
                                <VBox spacing="3.0">
                                    <Label text="Người bán" style="-fx-text-fill: #431476; -fx-font-weight: bold;"/>
                                    <Label fx:id="lblSeller" text="—"
                                           style="-fx-font-size: 14px; -fx-text-fill: #34495e;"/>
                                </VBox>
                                <VBox spacing="3.0">
                                    <Label text="Trạng thái" style="-fx-text-fill: #431476; -fx-font-weight: bold;"/>
                                    <Label fx:id="lblStatus" text="—"
                                           style="-fx-font-size: 14px; -fx-font-weight: bold;
                                      -fx-text-fill: #27ae60;"/>
                                </VBox>
                            </HBox>

                            <HBox spacing="36.0">
                                <VBox spacing="3.0">
                                    <Label text="Giá khởi điểm" style="-fx-text-fill: #431476; -fx-font-weight: bold;"/>
                                    <Label fx:id="lblStartPrice" text="—"
                                           style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                                </VBox>
                                <VBox spacing="3.0">
                                    <Label text="Bước giá" style="-fx-text-fill: #431476; -fx-font-weight: bold;"/>
                                    <Label fx:id="lblMinIncrement" text="—"
                                           style="-fx-font-size: 14px; -fx-font-weight: bold;
                                      -fx-text-fill: #27ae60;"/>
                                </VBox>
                            </HBox>

                            <VBox spacing="4.0"
                                  style="-fx-background-color: #9b59b612;
                             -fx-background-radius: 12; -fx-padding: 14 18;">
                                <Label text="GIÁ HIỆN TẠI" style="-fx-text-fill: #431476; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                                <Label fx:id="lblCurrentPrice" text="—"
                                       style="-fx-font-size: 30px; -fx-font-weight: bold;
                                  -fx-text-fill: #c0392b;"/>
                            </VBox>

                            <HBox spacing="0.0">
                                <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                                    <Label text="Thời gian còn lại" style="-fx-text-fill: #431476; -fx-font-weight: bold;"/>
                                    <Label fx:id="lblTimer" text="--:--:--"
                                           style="-fx-font-size: 22px; -fx-font-weight: bold;
                                      -fx-text-fill: #e67e22;
                                      -fx-font-family: 'Monospace';"/>
                                </VBox>
                                <VBox spacing="3.0" alignment="CENTER_RIGHT">
                                    <Label text="Lượt đặt giá" style="-fx-text-fill: #431476; -fx-font-weight: bold;"/>
                                    <Label fx:id="lblBidCount" text="0"
                                           style="-fx-font-size: 20px; -fx-font-weight: bold;
                                      -fx-text-fill: #431476;"/>
                                </VBox>
                            </HBox>

                            <HBox alignment="CENTER_LEFT" spacing="8.0">
                                <Label text="Kết thúc lúc:" style="-fx-text-fill: #431476; -fx-font-weight: bold;"/>
                                <Label fx:id="lblEndTime" text="—"
                                       style="-fx-font-size: 13.5px; -fx-text-fill: #7f8c8d;"/>
                            </HBox>
                        </VBox>

                        <VBox spacing="10.0"
                              styleClass="glass-box"
                              style="-fx-background-radius: 20; -fx-padding: 22 32 18 32;">

                            <Label text="Ảnh sản phẩm" style="-fx-text-fill: #431476; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                            <StackPane style="-fx-background-color: #111111; -fx-background-radius: 12;">
                                <padding><Insets top="8" right="8" bottom="8" left="8"/></padding>
                                <ImageView fx:id="imgProduct"
                                           fitHeight="170.0" fitWidth="336.0"
                                           preserveRatio="true"/>

                                <Button fx:id="btnPrevImage" text="&lt;" onAction="#handlePrevImage"
                                        style="-fx-background-color: rgba(0,0,0,0.6); -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold;"
                                        StackPane.alignment="CENTER_LEFT" visible="false"/>

                                <Button fx:id="btnNextImage" text="&gt;" onAction="#handleNextImage"
                                        style="-fx-background-color: rgba(0,0,0,0.6); -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold;"
                                        StackPane.alignment="CENTER_RIGHT" visible="false"/>

                                <Label fx:id="lblImageIndex" text="1/1"
                                       style="-fx-background-color: rgba(0,0,0,0.7); -fx-text-fill: white; -fx-padding: 3 8; -fx-background-radius: 6; -fx-font-size: 11px;"
                                       StackPane.alignment="BOTTOM_RIGHT" visible="false">
                                    <StackPane.margin><Insets bottom="4" right="4"/></StackPane.margin>
                                </Label>
                            </StackPane>

                            <Label text="Mô tả chi tiết" style="-fx-text-fill: #431476; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 8 0 0 0;"/>
                            <Label fx:id="lblDescription" text="—"
                                   wrapText="true"
                                   style="-fx-font-size: 13.5px; -fx-text-fill: #34495e; -fx-line-spacing: 4;"/>
                        </VBox>
                    </VBox>
                </ScrollPane>

                <VBox spacing="10.0">
                    <Button fx:id="btnPlaceBid"
                            text="THAM GIA ĐẶT GIÁ"
                            onAction="#handlePlaceBid"
                            styleClass="btn-auction-primary"
                            maxWidth="Infinity"
                            style="-fx-font-size: 15px; -fx-padding: 14 0;
                       -fx-font-weight: bold;"/>

                    <Button fx:id="btnMarkAsPaid"
                            text="✅ XÁC NHẬN THANH TOÁN"
                            onAction="#handleMarkAsPaid"
                            visible="false"
                            maxWidth="Infinity"
                            style="-fx-font-size: 14px; -fx-padding: 13 0; -fx-font-weight: bold;
                       -fx-background-color: #8e44ad; -fx-text-fill: white;
                       -fx-background-radius: 12; -fx-cursor: hand;"/>

                    <!-- Nút tải lại khi seller cập nhật thông tin phiên -->
                    <Button fx:id="btnReload"
                            text="🔄 Tải lại thông tin phiên"
                            onAction="#handleReload"
                            visible="false"
                            maxWidth="Infinity"
                            style="-fx-font-size: 13px; -fx-padding: 11 0; -fx-font-weight: bold;
                       -fx-background-color: #2980b9; -fx-text-fill: white;
                       -fx-background-radius: 12; -fx-cursor: hand;"/>

                    <Label fx:id="lblMessage"
                           visible="false"
                           wrapText="true"
                           alignment="CENTER"
                           style="-fx-font-size: 13.5px; -fx-text-fill: #2980b9; -fx-font-style: italic;"/>
                </VBox>

            </VBox>

            <!-- ══════════════════════════════════════
                 CỘT GIỮA – Biểu đồ biến động giá
                 ══════════════════════════════════════ -->
            <VBox spacing="16.0" HBox.hgrow="ALWAYS">

                <!-- Biểu đồ -->
                <VBox spacing="12.0" VBox.vgrow="ALWAYS"
                      styleClass="glass-box"
                      style="-fx-background-radius: 20; -fx-padding: 26 30 22 30;">

                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label text="Biến động giá đấu"
                               styleClass="login-main-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblChartInfo" text=""
                               style="-fx-font-size: 12.5px; -fx-text-fill: #9b59b6;"/>
                    </HBox>

                    <Separator style="-fx-background-color: #9b59b630;"/>

                    <LineChart fx:id="priceChart"
                               animated="false"
                               VBox.vgrow="ALWAYS"
                               style="-fx-font-size: 12px; -fx-background-color: transparent;">
                        <xAxis>
                            <CategoryAxis animated="false"
                                          label="Thời điểm"
                                          side="BOTTOM"
                                          tickLabelRotation="-45"/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis animated="false"
                                        label="Giá (VNĐ)"
                                        side="LEFT"/>
                        </yAxis>
                    </LineChart>
                </VBox>

                <VBox spacing="12.0"
                      styleClass="glass-box"
                      style="-fx-background-radius: 20; -fx-padding: 22 30 18 30;">

                    <Label text="Người dẫn đầu hiện tại"
                           styleClass="login-main-title"/>

                    <Separator style="-fx-background-color: #9b59b630;"/>

                    <HBox alignment="CENTER_LEFT" spacing="16.0"
                          style="-fx-padding: 12 18; -fx-background-color: rgba(241, 196, 15, 0.1);
                     -fx-background-radius: 14; -fx-border-color: rgba(241, 196, 15, 0.4);
                     -fx-border-radius: 14; -fx-border-width: 1.5;">

                        <StackPane>
                            <Region style="-fx-background-color: #f1c40f; -fx-background-radius: 50;
                               -fx-min-width: 50; -fx-min-height: 50;
                               -fx-effect: dropshadow(gaussian, #f1c40f90, 15, 0.6, 0, 0);"/>

                            <ImageView fx:id="imgLeaderAvatar"
                                       fitHeight="46.0" fitWidth="46.0"
                                       style="-fx-background-radius: 50;">
                                <image>
                                    <Image url="@../images/default_avatar.png"/>
                                </image>
                            </ImageView>

                            <Label text="👑" style="-fx-font-size: 22px; -fx-text-fill: #f39c12; -fx-effect: dropshadow(gaussian, #00000050, 4, 0, 1, 1);"
                                   StackPane.alignment="TOP_LEFT">
                                <StackPane.margin>
                                    <Insets top="-14" left="-14"/>
                                </StackPane.margin>
                            </Label>
                        </StackPane>

                        <VBox spacing="4.0" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
                            <Label fx:id="lblLeaderName" text="—"
                                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #431476;"/>
                            <Label fx:id="lblLeaderBid" text="—"
                                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #e67e22;"/>
                        </VBox>

                        <Label fx:id="lblLeaderTime" text=""
                               style="-fx-font-size: 12.5px; -fx-text-fill: #e67e22; -fx-font-style: italic;"/>
                    </HBox>
                </VBox>
            </VBox>

            <!-- ══════════════════════════════════════
                 CỘT PHẢI – Lịch sử đặt giá
                 ══════════════════════════════════════ -->
            <VBox spacing="12.0" prefWidth="300.0" HBox.hgrow="SOMETIMES"
                  styleClass="glass-box"
                  style="-fx-background-radius: 20; -fx-padding: 26 28 22 28;">

                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label text="Lịch sử đặt giá"
                           styleClass="login-main-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblHistoryCount" text=""
                           style="-fx-font-size: 12.5px; -fx-text-fill: #9b59b6;"/>
                </HBox>

                <Separator style="-fx-background-color: #9b59b630;"/>

                <!-- ListView lịch sử – controller tự render cell -->
                <ListView fx:id="lvBidHistory"
                          VBox.vgrow="ALWAYS"
                          style="-fx-background-radius: 12; -fx-font-size: 13.5px;
                                 -fx-background-color: transparent;"/>

                <!-- Ghi chú -->
                <Label wrapText="true"
                       text="Cập nhật tự động theo thời gian thực"
                       style="-fx-font-size: 12px; -fx-text-fill: #9b59b6;
                              -fx-font-style: italic; -fx-padding: 4 0 0 0;"/>
            </VBox>

        </HBox>

        <!-- ═══════════════════════════════════════════════════
             FOOTER
             ═══════════════════════════════════════════════════ -->
        <HBox alignment="CENTER"
              AnchorPane.bottomAnchor="8.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0">
            <Label text="© 2026 Auction House – Nơi kết nối người bán và người mua uy tín | Hotline: 1900-8888"
                   style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d88;"/>
        </HBox>

    </children>
</AnchorPane>