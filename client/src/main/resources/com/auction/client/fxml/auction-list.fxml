<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>

<AnchorPane fx:id="auctionListPane" prefWidth="1400.0" prefHeight="820.0"
            styleClass="auction-bg"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.client.controller.AuctionListController">

    <children>

        <!-- ═══════════════════════════ HEADER ═══════════════════════════ -->
        <HBox alignment="CENTER_LEFT" spacing="14.0"
              AnchorPane.topAnchor="18.0"
              AnchorPane.leftAnchor="24.0"
              AnchorPane.rightAnchor="24.0"
              prefHeight="80.0"
              styleClass="glass-box"
              style="-fx-background-radius: 18; -fx-padding: 14 30 14 30;">

            <ImageView fitHeight="48.0" fitWidth="48.0" pickOnBounds="true" preserveRatio="true"
                       style="-fx-effect: dropshadow(gaussian, #9b59b640, 8, 0, 0, 2);">
                <image><Image url="@/com/auction/client/images/logo.png"/></image>
            </ImageView>

            <VBox alignment="CENTER_LEFT" spacing="2.0">
                <Label text="Online Auction System" styleClass="auction-title"/>
                <Label text="Sàn đấu giá trực tuyến – Sôi động · Uy tín · Minh bạch"
                       styleClass="auction-subtitle"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Wallet -->
            <VBox alignment="CENTER_RIGHT" spacing="4.0"
                  style="-fx-padding: 0 18 0 0;
                         -fx-border-color: transparent #bdc3c750 transparent transparent;
                         -fx-border-width: 0 1 0 0;">
                <HBox alignment="CENTER_RIGHT" spacing="6.0">
                    <Label text="Số dư:" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
                    <Label fx:id="lblWalletBalance" text="Đang tải..."
                           style="-fx-font-weight: bold; -fx-text-fill: #f39c12; -fx-font-size: 14px;"/>
                </HBox>
                <Button text="💳 Chi tiết ví" onAction="#handleOpenWallet"
                        style="-fx-background-color: #8e44ad; -fx-text-fill: white;
                               -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 4 12;
                               -fx-background-radius: 14; -fx-cursor: hand;"/>
            </VBox>

            <!-- Profile -->
            <HBox fx:id="headerUserArea" alignment="CENTER" spacing="10.0"
                  onMouseClicked="#handleProfileClick"
                  style="-fx-cursor: hand; -fx-padding: 5 10; -fx-background-radius: 12;
                         -fx-background-color: transparent;">
                <ImageView fx:id="imgAvatar" fitHeight="38.0" fitWidth="38.0" preserveRatio="true"
                           style="-fx-effect: dropshadow(gaussian, #9b59b660, 6, 0, 0, 1);">
                    <image><Image url="@/com/auction/client/images/default_avatar.png"/></image>
                </ImageView>
                <VBox alignment="CENTER_LEFT" spacing="1.0">
                    <Label fx:id="lblUser"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #431476;"/>
                    <Label fx:id="lblRole"
                           style="-fx-font-size: 11px; -fx-text-fill: #9b59b6;"/>
                </VBox>
                <Label text="▾" style="-fx-font-size: 12px; -fx-text-fill: #9b59b6;"/>
            </HBox>

            <Button fx:id="btnTheme" onAction="#handleToggleTheme" styleClass="btn-auction-primary"
                    style="-fx-font-size: 12px; -fx-padding: 6 14;
                           -fx-background-color: rgba(80,30,120,0.7);"/>
            <Button fx:id="btnLogout" text="Đăng xuất" onAction="#handleLogout"
                    styleClass="btn-auction-primary"
                    style="-fx-font-size: 12px; -fx-padding: 6 18;"/>
        </HBox>

        <!-- ═══════════════════════════ MAIN CONTENT ═══════════════════════════ -->
        <HBox spacing="16.0"
              AnchorPane.topAnchor="114.0"
              AnchorPane.leftAnchor="24.0"
              AnchorPane.rightAnchor="24.0"
              AnchorPane.bottomAnchor="32.0">

            <!-- ══════════ SIDEBAR — chỉ danh mục, gọn ══════════ -->
            <VBox prefWidth="186.0" minWidth="186.0" maxWidth="186.0"
                  spacing="4.0"
                  styleClass="glass-box"
                  style="-fx-background-radius: 18; -fx-padding: 20 12;
                         -fx-background-color: #ffffff99;">

                <Label text="Danh mục"
                       style="-fx-font-size: 14px; -fx-font-weight: bold;
                              -fx-text-fill: #8e44ad; -fx-padding: 0 0 8 0;"/>

                <Button text="📁 Tất cả" onAction="#showAllItems" prefWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-font-size: 13px;
                               -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-padding: 7 8;"/>
                <Separator style="-fx-opacity: 0.35;"/>
                <Button text="🎨 Nghệ thuật" onAction="#showArts" prefWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-font-size: 13px;
                               -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-padding: 7 8;"/>
                <Separator style="-fx-opacity: 0.35;"/>
                <Button text="💻 Đồ điện tử" onAction="#showElectronics" prefWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-font-size: 13px;
                               -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-padding: 7 8;"/>
                <Separator style="-fx-opacity: 0.35;"/>
                <Button text="🚗 Phương tiện" onAction="#showVehicles" prefWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-font-size: 13px;
                               -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-padding: 7 8;"/>
                <Separator style="-fx-opacity: 0.35;"/>
                <Button text="📦 Tài sản khác" onAction="#showOthers" prefWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-font-size: 13px;
                               -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-padding: 7 8;"/>

                <!-- Badge trạng thái bộ lọc -->
                <Separator style="-fx-opacity: 0.35; -fx-padding: 6 0 2 0;"/>
                <Label fx:id="lblFilterStatus" text="" wrapText="true"
                       style="-fx-font-size: 10.5px; -fx-text-fill: #e67e22;
                              -fx-font-style: italic; -fx-padding: 4 2;"/>
            </VBox>

            <!-- ══════════ MAIN AREA ══════════ -->
            <VBox HBox.hgrow="ALWAYS" spacing="10.0"
                  styleClass="glass-box"
                  style="-fx-background-radius: 18; -fx-padding: 22 28 20 28;">

                <!-- Toolbar -->
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <VBox alignment="CENTER_LEFT" spacing="2.0">
                        <Label fx:id="lblMainTitle" text="Danh sách phiên đấu giá"
                               styleClass="login-main-title"/>
                        <Label fx:id="lblAuctionCount" text="Đang tải..."
                               style="-fx-font-size: 12px; -fx-text-fill: #9b59b6;"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <VBox alignment="CENTER_LEFT" spacing="3.0">
                        <Label text="Tìm kiếm" styleClass="field-label"/>
                        <TextField fx:id="txtSearch" promptText="Tên sản phẩm, người bán..."
                                   styleClass="input-auction" prefWidth="200.0"
                                   onKeyReleased="#handleSearch"/>
                    </VBox>

                    <VBox alignment="CENTER_LEFT" spacing="3.0">
                        <Label text="Trạng thái" styleClass="field-label"/>
                        <ComboBox fx:id="cboFilter" promptText="Tất cả" prefWidth="138.0"
                                  styleClass="input-auction" onAction="#handleFilter"/>
                    </VBox>

                    <VBox alignment="BOTTOM_LEFT" spacing="3.0">
                        <Label text=" " styleClass="field-label"/>
                        <Button fx:id="btnRefresh" text="⟳ Làm mới" onAction="#handleRefresh"
                                styleClass="btn-auction-primary"
                                style="-fx-font-size: 12px; -fx-padding: 7 16;"/>
                    </VBox>
                </HBox>

                <!-- ════ BỘ LỌC NÂNG CAO — 1 hàng ngang ════ -->
                <HBox alignment="CENTER_LEFT" spacing="12.0"
                      style="-fx-background-color: #9b59b610;
                             -fx-background-radius: 12;
                             -fx-padding: 10 16;
                             -fx-border-color: #9b59b630;
                             -fx-border-radius: 12;
                             -fx-border-width: 1;">

                    <Label text="🔍 Lọc nâng cao:"
                           style="-fx-font-size: 12px; -fx-font-weight: bold;
                                  -fx-text-fill: #8e44ad;"/>

                    <Separator orientation="VERTICAL" style="-fx-opacity: 0.4;"/>

                    <!-- Khoảng giá -->
                    <Label text="Giá:"
                           style="-fx-font-size: 12px; -fx-text-fill: #555;"/>
                    <TextField fx:id="txtPriceMin" promptText="Từ" prefWidth="92.0"
                               style="-fx-background-radius: 7; -fx-border-radius: 7;
                                      -fx-border-color: #9b59b650; -fx-font-size: 12px;
                                      -fx-padding: 5 7;"/>
                    <Label text="—" style="-fx-text-fill: #aaa; -fx-font-size: 13px;"/>
                    <TextField fx:id="txtPriceMax" promptText="Đến" prefWidth="92.0"
                               style="-fx-background-radius: 7; -fx-border-radius: 7;
                                      -fx-border-color: #9b59b650; -fx-font-size: 12px;
                                      -fx-padding: 5 7;"/>
                    <Label text="VNĐ"
                           style="-fx-font-size: 11px; -fx-text-fill: #aaa;"/>

                    <Separator orientation="VERTICAL" style="-fx-opacity: 0.4;"/>

                    <!-- Thời gian còn lại -->
                    <Label text="Còn ≥"
                           style="-fx-font-size: 12px; -fx-text-fill: #555;"/>
                    <TextField fx:id="txtMinMinutes" promptText="0" prefWidth="64.0"
                               style="-fx-background-radius: 7; -fx-border-radius: 7;
                                      -fx-border-color: #9b59b650; -fx-font-size: 12px;
                                      -fx-padding: 5 7;"/>
                    <Label text="phút"
                           style="-fx-font-size: 12px; -fx-text-fill: #888;"/>

                    <Separator orientation="VERTICAL" style="-fx-opacity: 0.4;"/>

                    <!-- Có ảnh -->
                    <Label text="Ảnh:"
                           style="-fx-font-size: 12px; -fx-text-fill: #555;"/>
                    <ComboBox fx:id="cboHasImage" prefWidth="118.0"
                              style="-fx-background-radius: 7; -fx-font-size: 12px;"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <!-- Nút -->
                    <Button fx:id="btnApplyFilter" text="✅ Áp dụng"
                            onAction="#handleApplyAdvancedFilter"
                            style="-fx-background-color: #8e44ad; -fx-text-fill: white;
                                   -fx-font-size: 12px; -fx-font-weight: bold;
                                   -fx-padding: 6 14; -fx-background-radius: 8; -fx-cursor: hand;"/>
                    <Button fx:id="btnClearFilter" text="🗑 Xóa"
                            onAction="#handleClearAdvancedFilter"
                            style="-fx-background-color: #95a5a6; -fx-text-fill: white;
                                   -fx-font-size: 12px; -fx-padding: 6 12;
                                   -fx-background-radius: 8; -fx-cursor: hand;"/>
                </HBox>

                <Separator style="-fx-background-color: #9b59b630;"/>

                <!-- Bảng dữ liệu -->
                <TableView fx:id="tbAuctions" VBox.vgrow="ALWAYS"
                           style="-fx-background-radius: 12; -fx-font-size: 13.5px;
                                  -fx-background-color: transparent;">
                    <columns>
                        <TableColumn fx:id="colNo"       text="#"            prefWidth="44.0"  style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colName"     text="Tên Sản Phẩm" prefWidth="240.0"/>
                        <TableColumn fx:id="colSeller"   text="Người Bán"    prefWidth="140.0"/>
                        <TableColumn fx:id="colPrice"    text="Giá Hiện Tại" prefWidth="138.0" style="-fx-alignment: CENTER_RIGHT;"/>
                        <TableColumn fx:id="colEndTime"  text="Kết Thúc Lúc" prefWidth="144.0" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colBidCount" text="Lượt Đặt"     prefWidth="80.0"  style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colHasImage" text="Ảnh"          prefWidth="52.0"  style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colStatus"   text="Trạng Thái"   prefWidth="106.0" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colAction"   text="Thao Tác"     prefWidth="98.0"  style="-fx-alignment: CENTER;"/>
                    </columns>

                    <placeholder>
                        <VBox alignment="CENTER" spacing="14.0" style="-fx-padding: 40;">
                            <StackPane>
                                <Circle radius="34" fill="#f3e5f5" stroke="#9b59b6"
                                        strokeType="INSIDE" strokeWidth="0.5"/>
                                <Label text="📦" style="-fx-font-size: 34px;"/>
                            </StackPane>
                            <VBox alignment="CENTER" spacing="5.0">
                                <Label text="Chưa có sản phẩm nào!"
                                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #431476;"/>
                                <Label text="Hãy thử xóa bộ lọc hoặc chọn danh mục khác."
                                       style="-fx-font-size: 12.5px; -fx-text-fill: #7f8c8d;"/>
                            </VBox>
                            <Button text="Làm mới dữ liệu" onAction="#handleRefresh"
                                    style="-fx-background-color: transparent; -fx-text-fill: #9b59b6;
                                           -fx-cursor: hand; -fx-underline: true;"/>
                        </VBox>
                    </placeholder>
                </TableView>

                <Label fx:id="lblMessage" visible="false" wrapText="true" alignment="CENTER"
                       style="-fx-font-size: 13px; -fx-text-fill: #e67e22; -fx-padding: 4 0 0 0;"/>
            </VBox>

        </HBox>

        <!-- Footer -->
        <HBox alignment="CENTER"
              AnchorPane.bottomAnchor="6.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0">
            <Label text="© 2026 Auction House – Nơi kết nối người bán và người mua uy tín | Hotline: 1900-8888"
                   style="-fx-font-size: 11.5px; -fx-text-fill: #7f8c8d88;"/>
        </HBox>

    </children>
</AnchorPane>
