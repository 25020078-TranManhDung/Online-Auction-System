<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.AuctionListController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="65.0" spacing="20.0" style="-fx-background-color: #2c3e50; -fx-padding: 0 25 0 25;" BorderPane.alignment="CENTER">
            <children>
                <Label text="SÀN ĐẤU GIÁ" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="22.0" />
                    </font>
                </Label>
                <Region HBox.hgrow="ALWAYS" />

                <Label fx:id="lblUserStatus" text="Xin chào, User" textFill="WHITE">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>

                <Button mnemonicParsing="false" onAction="#handleLogout" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold;" text="ĐĂNG XUẤT" />
            </children>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" BorderPane.alignment="CENTER">
            <content>
                <VBox spacing="25.0" style="-fx-padding: 30;">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label text="Danh sách sản phẩm đang diễn ra">
                                    <font>
                                        <Font name="System Bold" size="20.0" />
                                    </font>
                                </Label>
                                <Region HBox.hgrow="ALWAYS" />
                                <Button mnemonicParsing="false" onAction="#refreshList" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand;" text="Làm mới" />
                            </children>
                        </HBox>

                        <FlowPane fx:id="auctionContainer" hgap="30.0" vgap="30.0" />
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>