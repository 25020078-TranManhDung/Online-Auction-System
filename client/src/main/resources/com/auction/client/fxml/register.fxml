<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="registerPane" prefHeight="600.0" prefWidth="850.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.RegisterController">
    <children>
        <VBox alignment="CENTER" layoutX="275.0" layoutY="50.0" prefWidth="300.0" spacing="15.0" styleClass="login-container" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 30;">
            <children>
                <Label text="ĐĂNG KÝ" textFill="#2c3e50">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>

                <VBox spacing="5.0">
                    <children>
                        <Label text="Họ và tên" />
                        <TextField fx:id="regFullname" promptText="Nhập họ tên đầy đủ..." />
                    </children>
                </VBox>

                <VBox spacing="5.0">
                    <children>
                        <Label text="Tên đăng nhập" />
                        <TextField fx:id="regUsername" promptText="Chọn tên đăng nhập..." />
                    </children>
                </VBox>

                <VBox spacing="5.0">
                    <children>
                        <Label text="Mật khẩu" />
                        <PasswordField fx:id="regPassword" promptText="Nhập mật khẩu..." />
                    </children>
                </VBox>

                <VBox spacing="5.0">
                    <children>
                        <Label text="Xác nhận mật khẩu" />
                        <PasswordField fx:id="regConfirmPassword" promptText="Nhập lại mật khẩu..." />
                    </children>
                </VBox>

                <Button fx:id="btnRegister" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleRegister" styleClass="button-login" text="TẠO TÀI KHOẢN" />

                <Button mnemonicParsing="false" onAction="#goBackToLogin" style="-fx-background-color: transparent; -fx-text-fill: #2c3e50; -fx-cursor: hand;" text="Đã có tài khoản? Đăng nhập" />
            </children>
        </VBox>
    </children>
</AnchorPane>