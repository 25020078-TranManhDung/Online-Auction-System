<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<AnchorPane fx:id="adminDashboardPane" prefWidth="1400.0" prefHeight="800.0"
            styleClass="auction-bg"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.client.controller.AdminDashboardController">

    <children>

        <!-- ═══════════════════════════════════════════════════
             HEADER – đồng bộ với toàn bộ hệ thống
             ═══════════════════════════════════════════════════ -->
        <HBox alignment="CENTER_LEFT" spacing="14.0"
              AnchorPane.topAnchor="24.0"
              AnchorPane.leftAnchor="30.0"
              AnchorPane.rightAnchor="30.0"
              prefHeight="88.0"
              styleClass="glass-box"
              style="-fx-background-radius: 20; -fx-padding: 16 36 16 36;">

            <ImageView fitHeight="52.0" fitWidth="52.0"
                       pickOnBounds="true"
                       preserveRatio="true"
                       style="-fx-effect: dropshadow(gaussian, #9b59b640, 8, 0, 0, 2);">
                <image>
                    <Image url="@/com/auction/client/images/bg_login.jpg"/>
                </image>
            </ImageView>

            <VBox alignment="CENTER_LEFT" spacing="2.0">
                <Label text="Online Auction System" styleClass="auction-title"/>
                <Label text="Sàn đấu giá trực tuyến – Sôi động · Uy tín · Minh bạch"
                       styleClass="auction-subtitle"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox alignment="CENTER" spacing="14.0">
                <ImageView fx:id="imgAvatar"
                           fitHeight="40.0" fitWidth="40.0"
                           preserveRatio="true"
                           style="-fx-effect: dropshadow(gaussian, #9b59b660, 6, 0, 0, 1);">
                    <image>
                        <Image url="@/com/auction/client/images/default_avatar.png"/>
                    </image>
                </ImageView>
                <VBox alignment="CENTER_LEFT" spacing="1.0">
                    <Label fx:id="lblUser"
                           style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #431476;"/>
                    <Label text="Quản trị viên"
                           style="-fx-font-size: 12px; -fx-text-fill: #c0392b;
                                  -fx-font-weight: bold;"/>
                </VBox>
                <Button fx:id="btnLogout" text="Đăng xuất"
                        onAction="#handleLogout"
                        styleClass="btn-auction-primary"
                        style="-fx-font-size: 12.5px; -fx-padding: 7 22;"/>
                <Button text="💼 Ví hoa hồng" onAction="#handleOpenWallet"
                        style="-fx-background-color: #8e44ad; -fx-text-fill: white;
                               -fx-font-size: 12.5px; -fx-padding: 7 18;
                               -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: bold;"/>
            </HBox>
        </HBox>

        <!-- ═══════════════════════════════════════════════════
             THỐNG KÊ TỔNG QUAN – 5 thẻ
             ═══════════════════════════════════════════════════ -->
        <HBox spacing="14.0"
              AnchorPane.topAnchor="128.0"
              AnchorPane.leftAnchor="30.0"
              AnchorPane.rightAnchor="30.0"
              prefHeight="96.0">

            <!-- Tổng người dùng -->
            <VBox alignment="CENTER" spacing="4.0" HBox.hgrow="ALWAYS"
                  styleClass="glass-box"
                  style="-fx-background-radius: 16; -fx-padding: 14 20;">
                <Label text="Tổng người dùng" styleClass="field-label"/>
                <Label fx:id="lblTotalUsers" text="0"
                       style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #431476;"/>
            </VBox>

            <!-- Người dùng bị khoá -->
            <VBox alignment="CENTER" spacing="4.0" HBox.hgrow="ALWAYS"
                  styleClass="glass-box"
                  style="-fx-background-radius: 16; -fx-padding: 14 20;">
                <Label text="Đang bị khoá" styleClass="field-label"/>
                <Label fx:id="lblLockedUsers" text="0"
                       style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #c0392b;"/>
            </VBox>

            <!-- Tổng phiên đấu giá -->
            <VBox alignment="CENTER" spacing="4.0" HBox.hgrow="ALWAYS"
                  styleClass="glass-box"
                  style="-fx-background-radius: 16; -fx-padding: 14 20;">
                <Label text="Tổng phiên đấu giá" styleClass="field-label"/>
                <Label fx:id="lblTotalAuctions" text="0"
                       style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #2980b9;"/>
            </VBox>

            <!-- Phiên đang hoạt động -->
            <VBox alignment="CENTER" spacing="4.0" HBox.hgrow="ALWAYS"
                  styleClass="glass-box"
                  style="-fx-background-radius: 16; -fx-padding: 14 20;">
                <Label text="Phiên đang mở" styleClass="field-label"/>
                <Label fx:id="lblActiveAuctions" text="0"
                       style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
            </VBox>

            <!-- Tổng lượt đặt giá -->
            <VBox alignment="CENTER" spacing="4.0" HBox.hgrow="ALWAYS"
                  styleClass="glass-box"
                  style="-fx-background-radius: 16; -fx-padding: 14 20;">
                <Label text="Tổng lượt đặt giá" styleClass="field-label"/>
                <Label fx:id="lblTotalBids" text="0"
                       style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #e67e22;"/>
            </VBox>
        </HBox>

        <!-- ═══════════════════════════════════════════════════
             NỘI DUNG CHÍNH – TabPane
             ═══════════════════════════════════════════════════ -->
        <VBox spacing="0.0"
              AnchorPane.topAnchor="240.0"
              AnchorPane.leftAnchor="30.0"
              AnchorPane.rightAnchor="30.0"
              AnchorPane.bottomAnchor="36.0"
              styleClass="glass-box"
              style="-fx-background-radius: 20; -fx-padding: 0;">

            <TabPane fx:id="tabPane"
                     tabClosingPolicy="UNAVAILABLE"
                     VBox.vgrow="ALWAYS"
                     style="-fx-background-color: transparent;
                            -fx-tab-min-height: 44px; -fx-font-size: 14px;">

                <!-- ─────────────────────────────────
                     TAB 1 – Quản lý người dùng
                     ───────────────────────────────── -->
                <Tab text="👤  Quản lý người dùng">
                    <content>
                        <VBox spacing="16.0"
                              style="-fx-padding: 28 34 24 34;">

                            <!-- Toolbar -->
                            <HBox alignment="CENTER_LEFT" spacing="14.0">
                                <VBox spacing="2.0">
                                    <Label text="Danh sách người dùng"
                                           styleClass="login-main-title"/>
                                    <Label fx:id="lblUserCount" text=""
                                           style="-fx-font-size: 13px; -fx-text-fill: #9b59b6;"/>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS"/>
                                <VBox alignment="CENTER_LEFT" spacing="4.0">
                                    <Label text="Tìm kiếm" styleClass="field-label"/>
                                    <TextField fx:id="txtUserSearch"
                                               promptText="Tên đăng nhập, email..."
                                               styleClass="input-auction"
                                               prefWidth="220.0"
                                               onKeyReleased="#handleUserSearch"/>
                                </VBox>
                                <VBox alignment="CENTER_LEFT" spacing="4.0">
                                    <Label text="Vai trò" styleClass="field-label"/>
                                    <ComboBox fx:id="cboRoleFilter"
                                              promptText="Tất cả"
                                              prefWidth="140.0"
                                              styleClass="input-auction"
                                              onAction="#handleRoleFilter"/>
                                </VBox>
                                <VBox alignment="CENTER_LEFT" spacing="4.0">
                                    <Label text=" " styleClass="field-label"/>
                                    <Button fx:id="btnRefreshUsers"
                                            text="⟳  Làm mới"
                                            onAction="#handleRefreshUsers"
                                            styleClass="btn-auction-primary"
                                            style="-fx-font-size: 13px; -fx-padding: 8 20;"/>
                                </VBox>
                            </HBox>

                            <Separator style="-fx-background-color: #9b59b630;"/>

                            <!-- Bảng người dùng -->
                            <TableView fx:id="tvUsers"
                                       VBox.vgrow="ALWAYS"
                                       style="-fx-background-radius: 12; -fx-font-size: 14px;
                                              -fx-background-color: transparent;">
                                <columns>
                                    <TableColumn fx:id="colUserId"     text="#"             prefWidth="56.0"  style="-fx-alignment: CENTER;"/>
                                    <TableColumn fx:id="colUsername"   text="Tên đăng nhập" prefWidth="190.0"/>
                                    <TableColumn fx:id="colFullname"   text="Họ và tên"     prefWidth="190.0"/>
                                    <TableColumn fx:id="colEmail"      text="Email"         prefWidth="210.0"/>
                                    <TableColumn fx:id="colUserRole"   text="Vai trò"       prefWidth="120.0" style="-fx-alignment: CENTER;"/>
                                    <TableColumn fx:id="colUserStatus" text="Trạng thái"    prefWidth="120.0" style="-fx-alignment: CENTER;"/>
                                    <TableColumn fx:id="colUserAction" text="Thao tác"      prefWidth="160.0" style="-fx-alignment: CENTER;"/>
                                </columns>
                                <placeholder>
                                    <VBox alignment="CENTER" spacing="8.0">
                                        <Label text="Không tìm thấy người dùng nào"
                                               style="-fx-font-size: 15px; -fx-text-fill: #9b59b6;
                                                      -fx-font-style: italic;"/>
                                    </VBox>
                                </placeholder>
                            </TableView>

                            <Label fx:id="lblUserMessage"
                                   visible="false"
                                   wrapText="true"
                                   alignment="CENTER"
                                   style="-fx-font-size: 13.5px; -fx-text-fill: #e67e22;"/>
                        </VBox>
                    </content>
                </Tab>

                <!-- ─────────────────────────────────
                     TAB 2 – Quản lý phiên đấu giá
                     ───────────────────────────────── -->
                <Tab text="🔨  Quản lý phiên đấu giá">
                    <content>
                        <VBox spacing="16.0"
                              style="-fx-padding: 28 34 24 34;">

                            <!-- Toolbar -->
                            <HBox alignment="CENTER_LEFT" spacing="14.0">
                                <VBox spacing="2.0">
                                    <Label text="Tất cả phiên đấu giá"
                                           styleClass="login-main-title"/>
                                    <Label fx:id="lblAuctionCount" text=""
                                           style="-fx-font-size: 13px; -fx-text-fill: #9b59b6;"/>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS"/>
                                <VBox alignment="CENTER_LEFT" spacing="4.0">
                                    <Label text="Tìm kiếm" styleClass="field-label"/>
                                    <TextField fx:id="txtAuctionSearch"
                                               promptText="Tên sản phẩm, người bán..."
                                               styleClass="input-auction"
                                               prefWidth="230.0"
                                               onKeyReleased="#handleAuctionSearch"/>
                                </VBox>
                                <VBox alignment="CENTER_LEFT" spacing="4.0">
                                    <Label text="Trạng thái" styleClass="field-label"/>
                                    <ComboBox fx:id="cboAuctionStatusFilter"
                                              promptText="Tất cả"
                                              prefWidth="155.0"
                                              styleClass="input-auction"
                                              onAction="#handleAuctionStatusFilter"/>
                                </VBox>
                                <VBox alignment="CENTER_LEFT" spacing="4.0">
                                    <Label text=" " styleClass="field-label"/>
                                    <Button fx:id="btnRefreshAuctions"
                                            text="⟳  Làm mới"
                                            onAction="#handleRefreshAuctions"
                                            styleClass="btn-auction-primary"
                                            style="-fx-font-size: 13px; -fx-padding: 8 20;"/>
                                </VBox>
                            </HBox>

                            <Separator style="-fx-background-color: #9b59b630;"/>

                            <!-- Bảng phiên đấu giá -->
                            <TableView fx:id="tvAllAuctions"
                                       VBox.vgrow="ALWAYS"
                                       style="-fx-background-radius: 12; -fx-font-size: 14px;
                                              -fx-background-color: transparent;">
                                <columns>
                                    <TableColumn fx:id="colAuctionId"     text="#"            prefWidth="56.0"  style="-fx-alignment: CENTER;"/>
                                    <TableColumn fx:id="colAuctionName"   text="Sản phẩm"     prefWidth="230.0"/>
                                    <TableColumn fx:id="colSellerName"    text="Người bán"    prefWidth="160.0"/>
                                    <TableColumn fx:id="colCurrentBid"    text="Giá cao nhất" prefWidth="150.0" style="-fx-alignment: CENTER_RIGHT;"/>
                                    <TableColumn fx:id="colBidCount"      text="Lượt đặt"     prefWidth="90.0"  style="-fx-alignment: CENTER;"/>
                                    <TableColumn fx:id="colAuctionStatus" text="Trạng thái"   prefWidth="120.0" style="-fx-alignment: CENTER;"/>
                                    <TableColumn fx:id="colEndTime"       text="Kết thúc"     prefWidth="150.0" style="-fx-alignment: CENTER;"/>
                                    <TableColumn fx:id="colAuctionAction" text="Thao tác"     prefWidth="130.0" style="-fx-alignment: CENTER;"/>
                                </columns>
                                <placeholder>
                                    <VBox alignment="CENTER" spacing="8.0">
                                        <Label text="Không có phiên đấu giá nào"
                                               style="-fx-font-size: 15px; -fx-text-fill: #9b59b6;
                                                      -fx-font-style: italic;"/>
                                    </VBox>
                                </placeholder>
                            </TableView>

                            <Label fx:id="lblAuctionMessage"
                                   visible="false"
                                   wrapText="true"
                                   alignment="CENTER"
                                   style="-fx-font-size: 13.5px; -fx-text-fill: #e67e22;"/>
                        </VBox>
                    </content>
                </Tab>

                <!-- ─────────────────────────────────
                     TAB 3 – Lịch sử toàn bộ đặt giá
                     ───────────────────────────────── -->
                <Tab text="📋  Lịch sử đặt giá">
                    <content>
                        <VBox spacing="16.0"
                              style="-fx-padding: 28 34 24 34;">

                            <!-- Toolbar -->
                            <HBox alignment="CENTER_LEFT" spacing="14.0">
                                <VBox spacing="2.0">
                                    <Label text="Toàn bộ lịch sử đặt giá"
                                           styleClass="login-main-title"/>
                                    <Label fx:id="lblBidHistoryCount" text=""
                                           style="-fx-font-size: 13px; -fx-text-fill: #9b59b6;"/>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS"/>
                                <VBox alignment="CENTER_LEFT" spacing="4.0">
                                    <Label text="Tìm kiếm" styleClass="field-label"/>
                                    <TextField fx:id="txtBidSearch"
                                               promptText="Người đặt, sản phẩm..."
                                               styleClass="input-auction"
                                               prefWidth="220.0"
                                               onKeyReleased="#handleBidSearch"/>
                                </VBox>
                                <VBox alignment="CENTER_LEFT" spacing="4.0">
                                    <Label text=" " styleClass="field-label"/>
                                    <Button fx:id="btnRefreshBids"
                                            text="⟳  Làm mới"
                                            onAction="#handleRefreshBids"
                                            styleClass="btn-auction-primary"
                                            style="-fx-font-size: 13px; -fx-padding: 8 20;"/>
                                </VBox>
                            </HBox>

                            <Separator style="-fx-background-color: #9b59b630;"/>

                            <!-- Bảng lịch sử đặt giá -->
                            <TableView fx:id="tvBidHistory"
                                       VBox.vgrow="ALWAYS"
                                       style="-fx-background-radius: 12; -fx-font-size: 14px;
                                              -fx-background-color: transparent;">
                                <columns>
                                    <TableColumn fx:id="colBidNo"        text="#"            prefWidth="56.0"  style="-fx-alignment: CENTER;"/>
                                    <TableColumn fx:id="colBidder"       text="Người đặt"    prefWidth="180.0"/>
                                    <TableColumn fx:id="colBidProduct"   text="Sản phẩm"     prefWidth="220.0"/>
                                    <TableColumn fx:id="colBidAmount"    text="Số tiền"      prefWidth="150.0" style="-fx-alignment: CENTER_RIGHT;"/>
                                    <TableColumn fx:id="colBidTime"      text="Thời điểm"    prefWidth="170.0" style="-fx-alignment: CENTER;"/>
                                    <TableColumn fx:id="colBidStatus"    text="Kết quả"      prefWidth="120.0" style="-fx-alignment: CENTER;"/>
                                </columns>
                                <placeholder>
                                    <VBox alignment="CENTER" spacing="8.0">
                                        <Label text="Chưa có lịch sử đặt giá"
                                               style="-fx-font-size: 15px; -fx-text-fill: #9b59b6;
                                                      -fx-font-style: italic;"/>
                                    </VBox>
                                </placeholder>
                            </TableView>

                            <Label fx:id="lblBidMessage"
                                   visible="false"
                                   wrapText="true"
                                   alignment="CENTER"
                                   style="-fx-font-size: 13.5px; -fx-text-fill: #e67e22;"/>
                        </VBox>
                    </content>
                </Tab>

            </TabPane>
        </VBox>

        <!-- ═══════════════════════════════════════════════════
             FOOTER
             ═══════════════════════════════════════════════════ -->
        <HBox alignment="CENTER"
              AnchorPane.bottomAnchor="8.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0">
            <Label text="© 2026 Auction House – Nơi kết nối người bán và người mua uy tín | Hotline: 1900-8888"
                   style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d88;"/>
        </HBox>

    </children>
</AnchorPane>
