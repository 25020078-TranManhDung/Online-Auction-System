<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="1000.0" style="-fx-background-color: #f0f2f5;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.AdminDashboardController">
    <children>
        <VBox layoutX="25.0" layoutY="25.0" prefWidth="950.0" spacing="20.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <children>
                        <Label text="BẢNG QUẢN TRỊ (ADMIN)" textFill="#c0392b">
                            <font>
                                <Font name="System Bold" size="26.0" />
                            </font>
                        </Label>
                        <Button mnemonicParsing="false" onAction="#handleLogout" style="-fx-background-color: #e74c3c; -fx-text-fill: white;" text="Đăng xuất" />
                    </children>
                </HBox>

                <TabPane prefHeight="580.0" tabClosingPolicy="UNAVAILABLE" style="-fx-background-color: white; -fx-background-radius: 5;">
                    <tabs>
                        <Tab text="Quản lý Người dùng">
                            <content>
                                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0" style="-fx-padding: 20;">
                                    <children>
                                        <VBox spacing="15.0" prefWidth="910.0">
                                            <children>
                                                <TableView fx:id="tvUsers" prefHeight="450.0">
                                                    <columns>
                                                        <TableColumn fx:id="colUserId" prefWidth="80.0" text="ID" />
                                                        <TableColumn fx:id="colUsername" prefWidth="200.0" text="Tên đăng nhập" />
                                                        <TableColumn fx:id="colUserRole" prefWidth="150.0" text="Vai trò" />
                                                        <TableColumn fx:id="colUserStatus" prefWidth="150.0" text="Trạng thái" />
                                                        <TableColumn fx:id="colUserAction" prefWidth="250.0" text="Hành động (Khóa/Mở)" />
                                                    </columns>
                                                </TableView>
                                            </children>
                                        </VBox>
                                    </children>
                                </AnchorPane>
                            </content>
                        </Tab>

                        <Tab text="Quản lý Phiên đấu giá">
                            <content>
                                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0" style="-fx-padding: 20;">
                                    <children>
                                        <TableView fx:id="tvAllAuctions" prefHeight="480.0" prefWidth="910.0">
                                            <columns>
                                                <TableColumn fx:id="colAuctionId" prefWidth="80.0" text="ID" />
                                                <TableColumn fx:id="colAuctionName" prefWidth="250.0" text="Sản phẩm" />
                                                <TableColumn fx:id="colSellerName" prefWidth="150.0" text="Người bán" />
                                                <TableColumn fx:id="colCurrentBid" prefWidth="150.0" text="Giá cao nhất" />
                                                <TableColumn fx:id="colAuctionStatus" prefWidth="150.0" text="Trạng thái" />
                                                <TableColumn fx:id="colAuctionAction" prefWidth="120.0" text="Hủy phiên" />
                                            </columns>
                                        </TableView>
                                    </children>
                                </AnchorPane>
                            </content>
                        </Tab>
                    </tabs>
                </TabPane>
            </children>
        </VBox>
    </children>
</AnchorPane>