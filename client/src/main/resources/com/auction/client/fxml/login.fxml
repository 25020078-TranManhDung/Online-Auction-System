<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane fx:id="loginPane" prefHeight="600.0" prefWidth="850.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.LoginController">
    <children>
        <VBox alignment="CENTER" layoutX="275.0" layoutY="125.0" prefWidth="300.0" spacing="20.0" styleClass="login-container">
            <children>
                <Label text="ĐĂNG NHẬP">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>
                <TextField fx:id="txtUsername" promptText="Tên đăng nhập" />
                <PasswordField fx:id="txtPassword" promptText="Mật khẩu" />
                <Button fx:id="btnLogin" maxWidth="Infinity" onAction="#handleLogin" styleClass="button-login" text="ĐĂNG NHẬP" />
                <Label onMouseClicked="#goToRegister" text="Chưa có tài khoản? Đăng ký ngay" textFill="#2c3e50" style="-fx-cursor: hand;" />
            </children>
        </VBox>
    </children>
</AnchorPane>